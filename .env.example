# Copy this file to .env and fill in real values. .env is gitignored.

# --- Data lake paths (local disk by default; point at s3a://, abfss://, or
# gs:// URIs in production and Spark will read/write them transparently) ---
RAW_DATA_PATH=data/raw
BRONZE_PATH=data/bronze
SILVER_PATH=data/silver

# --- Embedding model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=256

# --- Postgres / pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=semantic_search
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GOLD_TABLE=review_embeddings
